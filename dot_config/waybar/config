{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 4,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "cpu",
        "temperature#cpu",
        "memory",
        "custom/gpu-usage",
        "temperature#gpu",
        "pulseaudio",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "active": "",
            "default": "",
            "empty": "",
            "urgent": ""
        },
        "persistent-workspaces": {
            "DP-2": [1, 3, 5],
            "DP-1": [2, 4]
        },
        "all-outputs": false,
        "on-click": "activate"
    },
    "clock": {
        "format": "<span color='#a5adcb'>{0:L%a %d.%m.}</span>  {0:%H:%M} \uf017",
        "tooltip": false,
        "on-click": "calendar-toggle",
        "timezone": "Europe/Zurich",
        "locale": "de_CH.UTF-8",
        "interval": 60
    },
    "tray": {
        "icon-size": 18,
        "spacing": 8
    },
    "cpu": {
        "format": "CPU {usage}% ",
        "tooltip-format": "CPU Load: {load}%\nAvg Freq: {avg_frequency} GHz",
        "interval": 5,
        "states": {
            "warning": 70,
            "critical": 90
        },
        "on-click": "alacritty -e htop"
    },
    "temperature#cpu": {
        "tooltip": true,
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "critical-threshold": 85,
        "format-critical": "{temperatureC}°C 🔥",
        "format": "{temperatureC}°C",
        "interval": 5
    },
    "memory": {
        "format": "RAM {percentage}% 󰍛",
        "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB\nSwap: {swapUsed:0.1f} GiB / {swapTotal:0.1f} GiB",
        "interval": 5,
        "states": {
            "warning": 80,
            "critical": 92
        },
        "on-click": "alacritty -e htop"
    },
    "custom/gpu-usage": {
        "exec": "cat /sys/class/drm/card1/device/gpu_busy_percent",
        "return-type": "text",
        "format": "GPU {}% 󰍹",
        "tooltip": true,
        "tooltip_format": "AMD GPU Usage",
        "interval": 2
    },
    "temperature#gpu": {
        "tooltip": true,
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp2_input",
        "critical-threshold": 95,
        "format-critical": "{temperatureC}°C 🥵",
        "format": "{temperatureC}°C",
        "interval": 5
    },
    "pulseaudio": {
        "format": "{volume}% {icon}  {format_source}",
        "format-bluetooth": "{volume}% {icon} ",
        "format-muted": " Muted",
        "format-source": " {volume}%",
        "format-source-muted": " Muted",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-middle": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "tooltip-format": "{desc} ({volume}%)"
    },
    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "wlogout &",
        "exec-on-event": false
    }
}
